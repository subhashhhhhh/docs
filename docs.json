{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Fastlytics Docs",
  "colors": {
    "primary": "#EF4444",
    "light": "#FB7185",
    "dark": "#DC2626"
  },
  "favicon": "/logo/icon-light-high-res.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Product",
        "icon": "flag",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "product/plans-and-limits"
            ]
          },
          {
            "group": "Using Fastlytics",
            "pages": [
              "product/race-analysis",
              "product/session-replay",
              "product/account-and-community"
            ]
          },
          {
            "group": "Data and coverage",
            "pages": [
              "product/data-and-availability"
            ]
          }
        ]
      },
      {
        "tab": "Platform",
        "icon": "terminal",
        "groups": [
          {
            "group": "Development",
            "pages": [
              "development",
              "platform/architecture",
              "platform/configuration",
              "platform/contributing",
              "mcp"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "API guide",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/endpoints"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Open app",
          "href": "https://fastlytics.app",
          "icon": "gauge"
        },
        {
          "anchor": "Pricing",
          "href": "https://fastlytics.app/pricing",
          "icon": "badge-dollar-sign"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/logo-light-high-res.png",
    "dark": "/logo/logo-dark-high-res.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@fastlytics.app",
        "icon": "life-buoy"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://fastlytics.app"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/fastlytics",
      "instagram": "https://instagram.com/fastlytics"
    }
  }
}
